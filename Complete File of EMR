    def show_item_price(self, event=None):
        category = self.category_combo.get()
        item_name = self.item_combo.get()
        if not category or not item_name:
            return
        item_list = self.procedures if category == "Procedures" else self.investigations if category == "Investigations" else self.drugs if category == "Drugs" else self.other_charges
        for item in item_list:
