    def update_drug_stock(self):
        selected = self.drugs_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Please select a drug")
            return
        drug_name = self.drugs_tree.item(selected[0])['values'][0]
        for drug in self.drugs:
            if drug['name'] == drug_name:
                dialog = tk.Toplevel(self.root)
                dialog.title(f"Update Stock: {drug_name}")
                dialog.geometry("300x200")
                ttk.Label(dialog, text=f"Current Quantity: {drug['quantity']}").pack(pady=10)
                ttk.Label(dialog, text="Add/Remove Quantity:").pack(pady=5)
                qty_var = tk.StringVar()
                qty_entry = ttk.Entry(dialog, textvariable=qty_var, width=15)
                qty_entry.pack(pady=5)
                ttk.Label(dialog, text="(+ for addition, - for deduction)").pack(pady=5)
                def apply_stock_change():
                    try:
                        change = int(qty_var.get())
                        new_qty = drug['quantity'] + change
                        if new_qty < 0:
                            messagebox.showerror("Error", "Quantity cannot be negative")
                            return
                        drug['quantity'] = new_qty
                        drug['last_updated'] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                        self.drug_inventory_log.append({
                            "drug_name": drug_name, "change": change,
                            "type": "ADJUST" if change > 0 else "DEDUCT",
                            "timestamp": drug['last_updated'], "batch": drug.get('batch_no', ''), "user": "Admin"
                        })
                        self.save_data_to_files()
                        self.load_drugs_list()
                        dialog.destroy()
                        messagebox.showinfo("Success", f"Stock updated to {new_qty}")
                    except ValueError:
                        messagebox.showerror("Error", "Please enter valid number")
                ttk.Button(dialog, text="Apply", command=apply_stock_change).pack(pady=20)
                break

    def load_drugs_list(self):
        for item in self.drugs_tree.get_children():
            self.drugs_tree.delete(item)
        low_stock_count = 0
        for drug in self.drugs:
            quantity = drug.get('quantity', 0)
            min_stock = drug.get('min_stock', 10)
            if quantity == 0:
                status = "OUT OF STOCK"
                low_stock_count += 1
            elif quantity <= min_stock:
                status = f"LOW ({quantity})"
                low_stock_count += 1
            else:
                status = "OK"
            self.drugs_tree.insert("", "end", values=(
                drug['name'], f"N{drug['price']:,.2f}", quantity, min_stock, drug.get('category', ''), status
            ), tags=(status[:3],))
        self.drugs_tree.tag_configure("OUT", foreground="red")
        self.drugs_tree.tag_configure("LOW", foreground="orange")
        self.drugs_tree.tag_configure("OK", foreground="green")
        self.low_stock_label.config(text=f"Warning: {low_stock_count} drug(s) have low or no stock!" if low_stock_count > 0 else "")

