    @staticmethod
    def generate_recommendations(patient_data, emr_records, lab_results, radiology_reports, prescriptions):
        """Generate clinical recommendations based on patient data"""
        recommendations = []
        
        # Check for lab abnormalities
        for lab in lab_results:
            if lab.get('status') == 'Completed':
                result = lab.get('result', '')
                test_name = lab.get('test_name', '').lower()
                
                # Malaria check
                if 'malaria' in test_name and 'positive' in result.lower():
                    recommendations.append("Malaria positive - Consider antimalarial therapy and follow-up")
                
                # Blood sugar checks
                if 'glucose' in test_name:
                    try:
                        val = float(re.findall(r'[\d.]+', result)[0]) if result else 0
                        if val > 200:
                            recommendations.append(f"Elevated glucose ({val}) - Consider diabetes management")
                        elif val < 70:
                            recommendations.append(f"Low glucose ({val}) - Evaluate for hypoglycemia")
                    except (ValueError, IndexError):
                        pass
                
                # HbA1c
                if 'hba1c' in test_name:
                    try:
                        val = float(re.findall(r'[\d.]+', result)[0]) if result else 0
                        if val > 7.0:
                            recommendations.append(f"Elevated HbA1c ({val}) - Optimize diabetes control")
                    except (ValueError, IndexError):
                        pass
                
                # Renal function
                if 'creatinine' in test_name:
                    try:
                        val = float(re.findall(r'[\d.]+', result)[0]) if result else 0
                        if val > 1.2:
                            recommendations.append(f"Elevated creatinine ({val}) - Monitor renal function closely")
                    except (ValueError, IndexError):
                        pass
                
                # Hemoglobin
                if 'hemoglobin' in test_name or 'hb' in test_name:
                    try:
                        val = float(re.findall(r'[\d.]+', result)[0]) if result else 0
                        if val < 12:
                            recommendations.append(f"Low hemoglobin ({val}) - Evaluate for anemia")
                    except (ValueError, IndexError):
                        pass
                
                # WBC
                if 'wbc' in test_name or 'white blood' in test_name:
                    try:
                        val = float(re.findall(r'[\d.]+', result)[0]) if result else 0
                        if val > 11:
                            recommendations.append(f"Elevated WBC ({val}) - Possible infection")
                    except (ValueError, IndexError):
                        pass
        
        # Check vitals from EMR
        if emr_records:
            latest = emr_records[-1]
            bp = latest.get('bp', '')
            temp = latest.get('temperature', '')
            hr = latest.get('heart_rate', '')
            
            if bp:
                try:
                    parts = re.findall(r'(\d+)/(\d+)', bp)
                    if parts:
                        sys, dia = map(int, parts[0])
                        if sys > 180 or dia > 120:
                            recommendations.append("Severe hypertension - Urgent BP management needed")
                        elif sys > 140 or dia > 90:
                            recommendations.append("Elevated blood pressure - Consider antihypertensive therapy")
                        elif sys < 90 or dia < 60:
                            recommendations.append("Low blood pressure - Evaluate for hypotension")
                except (ValueError, IndexError):
                    pass
            
            if temp:
                try:
                    temp_val = float(re.findall(r'[\d.]+', str(temp))[0]) if temp else 0
                    if temp_val > 38.5:
                        recommendations.append(f"Fever ({temp_val}°C) - Evaluate for infection")
                    elif temp_val < 35.5:
                        recommendations.append(f"Hypothermia ({temp_val}°C) - Monitor closely")
                except (ValueError, IndexError):
                    pass
            
            if hr:
                try:
                    hr_val = float(re.findall(r'[\d.]+', str(hr))[0]) if hr else 0
                    if hr_val > 100:
                        recommendations.append(f"Tachycardia ({hr_val} bpm) - Evaluate cause")
                    elif hr_val < 60:
                        recommendations.append(f"Bradycardia ({hr_val} bpm) - Monitor closely")
                except (ValueError, IndexError):
                    pass
        
        # General recommendations
        if len(emr_records) > 5:
            recommendations.append("Patient has multiple visits - Consider comprehensive review")
        
        if len(prescriptions) > 3:
            recommendations.append("Multiple prescriptions - Review for polypharmacy")
        
        if not recommendations:
            recommendations = [
                "Continue current treatment plan",
                "Schedule follow-up appointment in 2-4 weeks",
                "Monitor vital signs regularly",
                "Maintain healthy lifestyle",
                "Complete any pending investigations"
            ]
        
        return recommendations[:5]

