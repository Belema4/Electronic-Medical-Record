        values = self.results_tree.item(selected[0])['values']
        result_id = values[3] if len(values) > 3 else ""
        
        results_file = "patient_results/results_metadata.json"
        if os.path.exists(results_file):
            try:
                with open(results_file, "r", encoding="utf-8") as f:
                    all_results = json.load(f)
                
                to_remove = None
                for r in all_results:
                    if r.get('result_id') == result_id:
                        to_remove = r
                        break
                
                if to_remove:
                    all_results.remove(to_remove)
                    
                    file_path = to_remove.get('file_path') or to_remove.get('image_path')
                    if file_path and os.path.exists(file_path):
                        try:
                            os.remove(file_path)
                        except:
                            pass
                    
                    with open(results_file, "w", encoding="utf-8") as f:
                        json.dump(all_results, f, indent=2, ensure_ascii=False)
                    
                    self.refresh_results_list()
                    messagebox.showinfo("Success", "Result deleted successfully")
                
            except Exception as e:
                messagebox.showerror("Error", f"Failed to delete result: {str(e)}")

