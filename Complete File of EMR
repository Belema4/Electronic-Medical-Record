    def auto_bill_prescriptions(self):
        pid = self.patient_id_entry.get()
        if not pid:
            messagebox.showwarning("Warning", "Please load a patient first")
            return
        
        if not hasattr(self, 'prescriptions'):
            self.prescriptions = []
        
        patient_prescriptions = [p for p in self.prescriptions if p.get('patient_id') == pid and p.get('billed', False) == False]
        
        if not patient_prescriptions:
            messagebox.showinfo("Info", "No unbilled prescriptions found for this patient")
            return
        
        added_count = 0
        for presc in patient_prescriptions:
            drug_name = presc.get('drug_name')
            qty = presc.get('quantity', 1)
            
            for drug in self.drugs:
                if drug['name'] == drug_name:
                    total = drug['price'] * qty
                    self.bill_tree.insert("", "end", values=(
                        f"{drug_name} (Rx)", "Drugs", qty, f"N{drug['price']:,.2f}", f"N{total:,.2f}"
                    ))
                    presc['billed'] = True
                    added_count += 1
                    break
        
        self.update_total()
        self.save_data_to_files()
        messagebox.showinfo("Success", f"Added {added_count} prescription item(s) to bill")

