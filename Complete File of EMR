    def add_item_to_bill(self):
        try:
            category = self.category_combo.get()
            item_name = self.item_combo.get()
            quantity_str = self.quantity_entry.get()
            if not category or not item_name:
                messagebox.showwarning("Warning", "Please select category and item")
                return
            quantity = int(quantity_str)
            if quantity <= 0:
                messagebox.showerror("Error", "Quantity must be greater than 0")
                return
            item_list = self.procedures if category == "Procedures" else self.investigations if category == "Investigations" else self.drugs if category == "Drugs" else self.other_charges
            item = None
            for it in item_list:
                if it['name'] == item_name:
                    if category == "Drugs" and it.get('quantity', 0) < quantity:
                        messagebox.showerror("Insufficient Stock", f"Only {it.get('quantity', 0)} available")
                        return
                    item = it
                    break
            if not item:
                messagebox.showerror("Error", "Item not found")
                return
            unit_price = item['price']
            total_price = unit_price * quantity
            self.bill_tree.insert("", "end", values=(
                item_name, category, quantity, f"N{unit_price:,.2f}", f"N{total_price:,.2f}"
            ))
            self.update_total()
        except ValueError:
            messagebox.showerror("Error", "Please enter valid quantity")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to add item: {str(e)}")

    def update_total(self):
        total = 0
        for item in self.bill_tree.get_children():
            values = self.bill_tree.item(item)['values']
            total += float(values[4].replace('N', '').replace(',', ''))
        self.total_label.config(text=f"Total: N{total:,.2f}")

    def remove_selected_item(self):
        selected = self.bill_tree.selection()
        if selected:
            self.bill_tree.delete(selected)
            self.update_total()

    def clear_bill(self):
        for item in self.bill_tree.get_children():
            self.bill_tree.delete(item)
        self.update_total()
        if hasattr(self, 'patient_name_entry'):
            self.patient_name_entry.delete(0, tk.END)
            self.patient_id_entry.delete(0, tk.END)
            self.patient_age_entry.delete(0, tk.END)
            self.patient_gender_combo.set('')
        if hasattr(self, 'category_combo'):
            self.category_combo.set('')
            self.item_combo.set('')
            self.quantity_entry.delete(0, tk.END)
            self.quantity_entry.insert(0, "1")
            self.price_display.config(text="N0.00")
            self.stock_label.config(text="")

    def generate_bill(self):
        try:
            patient_id = self.patient_id_entry.get()
            patient_name = self.patient_name_entry.get()
            if not patient_id or not patient_name:
                messagebox.showwarning("Warning", "Please enter patient information")
                return
            items = []
            for item in self.bill_tree.get_children():
                values = self.bill_tree.item(item)['values']
                items.append({
                    'name': values[0], 'category': values[1], 'quantity': int(values[2]),
                    'unit_price': float(values[3].replace('N', '').replace(',', '')),
                    'total': float(values[4].replace('N', '').replace(',', ''))
                })
            if not items:
                messagebox.showwarning("Warning", "No items in the bill")
                return
            for item in items:
                if item['category'] == 'Drugs':
                    for drug in self.drugs:
                        if drug['name'] == item['name']:
                            new_qty = drug['quantity'] - item['quantity']
                            if new_qty < 0:
                                messagebox.showerror("Error", f"Insufficient stock for {drug['name']}")
                                return
                            drug['quantity'] = new_qty
                            break
            bill_id = f"BILL{datetime.now().strftime('%Y%m%d%H%M%S')}"
            total_amount = sum(item['total'] for item in items)
            bill_data = {
                'bill_id': bill_id,
                'patient_info': {
                    'id': patient_id, 'name': patient_name,
                    'age': self.patient_age_entry.get(),
                    'gender': self.patient_gender_combo.get()
                },
                'items': items, 'total': total_amount,
                'timestamp': datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                'status': 'Pending'
            }
            self.patient_bills.append(bill_data)
            self.save_data_to_files()
            bill_summary = f"BILL GENERATED SUCCESSFULLY!\n\n"
            bill_summary += f"Bill ID: {bill_id}\n"
            bill_summary += f"Patient: {patient_name} (ID: {patient_id})\n"
            bill_summary += f"Date: {bill_data['timestamp']}\n"
            bill_summary += f"Total Amount: N{total_amount:,.2f}\n\nItems:\n"
            for item in items:
                bill_summary += f"  - {item['name']}: {item['quantity']} x N{item['unit_price']:,.2f} = N{item['total']:,.2f}\n"
            messagebox.showinfo("Bill Generated", bill_summary)
            self.clear_bill()
        except Exception as e:
