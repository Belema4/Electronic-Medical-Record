            messagebox.showwarning("Warning", "No patient selected. Please select a patient first.")

    def on_rad_study_select(self, event=None):
        study_name = self.rad_study_combo.get()
        for study in self.radiology_catalog:
            if study['name'] == study_name:
                self.rad_price_label.config(text=f"Price: N{study['price']:,.2f}")
                return

    def request_imaging(self):
        pid = self.rad_patient_id.get()
        study_name = self.rad_study_combo.get()
        doctor = self.rad_doctor.get()
        if not pid or not study_name:
            messagebox.showwarning("Warning", "Select patient and study")
            return
        request_id = f"RAD{datetime.now().strftime('%Y%m%d%H%M%S')}"
        patient_name = self.rad_patient_name.cget("text") or pid
        if not hasattr(self, 'radiology_requests'):
            self.radiology_requests = []
        self.radiology_requests.append({
            "request_id": request_id, "patient_id": pid, "patient_name": patient_name,
            "study": study_name, "doctor": doctor,
            "date": datetime.now().strftime("%Y-%m-%d %H:%M"),
            "status": "Pending", "findings": "", "impression": "", "radiologist": ""
        })
        self.save_data_to_files()
        self.refresh_rad_pending()
        self.rad_indication.delete(1.0, tk.END)
        messagebox.showinfo("Success", f"Imaging requested: {request_id}")

    def refresh_rad_pending(self):
        if not hasattr(self, 'rad_pending_tree'):
            return
        for item in self.rad_pending_tree.get_children():
            self.rad_pending_tree.delete(item)
        if hasattr(self, 'radiology_requests'):
            for req in self.radiology_requests:
                if req.get('status') == 'Pending':
                    self.rad_pending_tree.insert("", "end", values=(
                        req['request_id'], req['patient_name'], req['study'],
                        req.get('doctor', ''), req['date'], req['status']
                    ))

    def enter_rad_report(self):
        selected = self.rad_pending_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Select a pending study")
            return
        values = self.rad_pending_tree.item(selected[0])['values']
        self.current_rad_request_id = values[0]
        messagebox.showinfo("Info", f"Enter report for {self.current_rad_request_id}")

    def save_rad_report(self):
        if not hasattr(self, 'current_rad_request_id') or not self.current_rad_request_id:
            messagebox.showwarning("Warning", "Select a study first")
            return
        if hasattr(self, 'radiology_requests'):
            for req in self.radiology_requests:
                if req['request_id'] == self.current_rad_request_id:
                    req['findings'] = self.rad_findings.get(1.0, tk.END).strip()
                    req['impression'] = self.rad_impression.get(1.0, tk.END).strip()
                    req['radiologist'] = self.rad_radiologist.get()
                    req['status'] = 'Completed'
                    req['date_completed'] = datetime.now().strftime("%Y-%m-%d %H:%M")
                    self.save_data_to_files()
                    self.refresh_rad_pending()
                    self.refresh_rad_reports()
                    self.rad_findings.delete(1.0, tk.END)
                    self.rad_impression.delete(1.0, tk.END)
                    self.rad_radiologist.delete(0, tk.END)
                    self.current_rad_request_id = ""
                    messagebox.showinfo("Success", "Report saved!")
                    return

    def refresh_rad_reports(self):
        if not hasattr(self, 'rad_reports_tree'):
            return
        for item in self.rad_reports_tree.get_children():
            self.rad_reports_tree.delete(item)
        if hasattr(self, 'radiology_requests'):
            for req in reversed(self.radiology_requests):
                if req.get('status') == 'Completed':
                    self.rad_reports_tree.insert("", "end", values=(
                        req.get('date_completed', ''), req['patient_name'], req['study'],
                        req.get('findings', '')[:50] + "...", req.get('impression', '')[:50] + "...",
                        req.get('radiologist', '')
                    ))

