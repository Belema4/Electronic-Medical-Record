        self.generate_patient_id()
        self.reg_patient_name.delete(0, tk.END)
        self.reg_dob.delete(0, tk.END)
        self.reg_dob.insert(0, datetime.now().strftime("%Y-%m-%d"))
        self.reg_gender.set('')
        self.reg_phone.delete(0, tk.END)
        self.reg_address.delete(0, tk.END)
