    def generate_bill_from_emr(self, dept):
        id_map = {
            "gm": (self.gm_patient_id, self.gm_patient_name),
            "ped": (self.ped_patient_id, self.ped_child_name),
            "obs": (self.obs_patient_id, self.obs_patient_name),
            "gyn": (self.gyn_patient_id, self.gyn_patient_name),
            "sur": (self.sur_patient_id, self.sur_patient_name),
            "card": (self.card_patient_id, self.card_patient_name),
            "emg": (self.emg_patient_id, self.emg_patient_name),
        }
        
        pid_widget, name_widget = id_map.get(dept, (None, None))
        if not pid_widget:
            return
        
        patient_id = pid_widget.get() if pid_widget else ""
        patient_name = name_widget.get() if name_widget else ""
        
        if not patient_id:
            messagebox.showwarning("Warning", "Please enter Patient ID first")
            return
        
        self.select_tab("Billing")
        if hasattr(self, 'patient_id_entry') and self.patient_id_entry:
            self.patient_id_entry.delete(0, tk.END)
            self.patient_id_entry.insert(0, patient_id)
            self.patient_name_entry.delete(0, tk.END)
            self.patient_name_entry.insert(0, patient_name)
            
            # Try to fill age and gender from patient data
            for bill in self.patient_bills:
                if 'patient_info' in bill and bill['patient_info'].get('id') == patient_id:
                    self.patient_age_entry.delete(0, tk.END)
                    self.patient_age_entry.insert(0, bill['patient_info'].get('age', ''))
                    self.patient_gender_combo.set(bill['patient_info'].get('gender', ''))
                    break
        
        self.set_current_patient(patient_id)
        self.active_patient_label.config(text=f"{patient_name} (ID: {patient_id})")
        messagebox.showinfo("Success", "Patient information transferred to billing tab")

