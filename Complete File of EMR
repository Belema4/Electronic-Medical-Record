    def on_pharm_drug_select(self, event=None):
        drug_name = self.pharm_drug_combo.get()
        for drug in self.drugs:
            if drug['name'] == drug_name:
                self.pharm_stock_label.config(text=f"Available: {drug.get('quantity', 0)} units")
                self.pharm_price_label.config(text=f"Unit Price: N{drug['price']:,.2f}")
                if drug.get('quantity', 0) <= drug.get('min_stock', 0):
                    self.pharm_stock_label.config(foreground="red")
                else:
                    self.pharm_stock_label.config(foreground="green")
                return

    def add_to_prescription(self):
        drug_name = self.pharm_drug_combo.get()
        try:
            qty = int(self.pharm_qty.get())
        except ValueError:
            messagebox.showwarning("Warning", "Invalid quantity")
            return
        if not drug_name or qty <= 0:
            messagebox.showwarning("Warning", "Select drug and enter valid quantity")
            return
        for drug in self.drugs:
            if drug['name'] == drug_name:
                if drug.get('quantity', 0) < qty:
                    messagebox.showerror("Insufficient Stock", f"Only {drug.get('quantity', 0)} available")
                    return
                total = drug['price'] * qty
                self.pharm_cart_tree.insert("", "end", values=(
                    drug_name, qty, f"N{drug['price']:,.2f}", f"N{total:,.2f}", self.pharm_instructions.get()
                ))
                self.update_pharm_total()
                self.pharm_instructions.delete(0, tk.END)
                self.pharm_instructions.insert(0, "Take as directed by physician")
                return
        messagebox.showerror("Error", "Drug not found")

    def update_pharm_total(self):
        total = 0
        for item in self.pharm_cart_tree.get_children():
            val = self.pharm_cart_tree.item(item)['values'][3]
            total += float(val.replace('N', '').replace(',', ''))
        self.pharm_total_label.config(text=f"Total: N{total:,.2f}")

    def remove_pharm_item(self):
        selected = self.pharm_cart_tree.selection()
        if selected:
            self.pharm_cart_tree.delete(selected)
            self.update_pharm_total()

    def clear_pharmacy(self):
        for item in self.pharm_cart_tree.get_children():
            self.pharm_cart_tree.delete(item)
        self.pharm_patient_id.delete(0, tk.END)
        self.pharm_patient_name.config(text="")
        self.pharm_drug_combo.set('')
        self.pharm_qty.delete(0, tk.END)
        self.pharm_qty.insert(0, "1")
        self.pharm_stock_label.config(text="")
        self.pharm_price_label.config(text="Unit Price: N0.00")
        self.update_pharm_total()

    def dispense_prescription(self):
        pid = self.pharm_patient_id.get()
        if not pid:
            messagebox.showwarning("Warning", "Enter Patient ID")
            return
        if not self.pharm_cart_tree.get_children():
            messagebox.showwarning("Warning", "No items in prescription")
            return
        
        if not hasattr(self, 'prescriptions'):
            self.prescriptions = []
        
        for item in self.pharm_cart_tree.get_children():
            values = self.pharm_cart_tree.item(item)['values']
            drug_name = values[0]
            qty = int(values[1])
            instructions = values[4]
            
            for drug in self.drugs:
                if drug['name'] == drug_name:
                    if drug['quantity'] < qty:
                        messagebox.showerror("Insufficient Stock", f"Only {drug['quantity']} available for {drug_name}")
                        return
                    drug['quantity'] -= qty
                    
                    self.prescriptions.append({
                        'patient_id': pid,
                        'drug_name': drug_name,
                        'quantity': qty,
                        'instructions': instructions,
                        'dispensed_date': datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                        'billed': False
                    })
                    
                    self.drug_inventory_log.append({
                        "drug_name": drug_name, "change": -qty, "type": "DISPENSE",
                        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                        "batch": drug.get('batch_no', ''), "user": "Pharmacist"
                    })
                    break
        
        self.save_data_to_files()
        self.refresh_pharm_inv()
        messagebox.showinfo("Success", "Prescription dispensed! Stock updated.")
        self.clear_pharmacy()

    def refresh_pharm_inv(self):
        for item in self.pharm_inv_tree.get_children():
            self.pharm_inv_tree.delete(item)
        for drug in self.drugs:
            qty = drug.get('quantity', 0)
            min_stock = drug.get('min_stock', 0)
            if qty == 0:
                status = "OUT"
            elif qty <= min_stock:
                status = "LOW"
            else:
                status = "OK"
            self.pharm_inv_tree.insert("", "end", values=(
                drug['name'], f"N{drug['price']:,.2f}", qty, min_stock, status
            ), tags=(status,))
        self.pharm_inv_tree.tag_configure("OUT", foreground="red")
        self.pharm_inv_tree.tag_configure("LOW", foreground="orange")
        self.pharm_inv_tree.tag_configure("OK", foreground="green")
        self.pharm_drug_combo['values'] = [d['name'] for d in self.drugs]

