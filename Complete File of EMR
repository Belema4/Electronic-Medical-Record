    def backup_data(self):
        try:
            backup_dir = self.backup_dir.get()
            if not os.path.exists(backup_dir):
                os.makedirs(backup_dir)
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            backup_file = os.path.join(backup_dir, f"backup_{timestamp}.zip")
            import zipfile
            with zipfile.ZipFile(backup_file, 'w') as zipf:
                data_files = ['procedures.json', 'investigations.json', 'drugs.json', 'other_charges.json',
                              'bills.json', 'inventory_log.json', 'emr.json', 'patients.json', 'settings.json',
                              'appointments.json', 'lab_tests.json', 'radiology_requests.json',
                              'prescriptions.json', 'consent_forms.json', 'ml_training_data.json']
                for file in data_files:
                    if os.path.exists(file):
                        zipf.write(file)
            self.last_backup_label.config(text=datetime.now().strftime("%Y-%m-%d %H:%M"))
            messagebox.showinfo("Success", f"Backup created: {backup_file}")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to create backup: {str(e)}")

    def restore_backup(self):
        try:
            backup_file = filedialog.askopenfilename(filetypes=[("Backup files", "*.zip"), ("All files", "*.*")])
            if backup_file:
                if messagebox.askyesno("Confirm", "Restore from backup will replace current data. Continue?"):
                    import zipfile
                    import shutil
                    temp_dir = tempfile.mkdtemp()
                    with zipfile.ZipFile(backup_file, 'r') as zipf:
                        zipf.extractall(temp_dir)
                    for file in os.listdir(temp_dir):
                        src = os.path.join(temp_dir, file)
                        if os.path.isfile(src):
                            shutil.copy2(src, file)
                    shutil.rmtree(temp_dir)
                    self.load_data_from_files()
                    self.update_dashboard()
                    messagebox.showinfo("Success", "Backup restored!")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to restore backup: {str(e)}")

