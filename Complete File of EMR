    def set_current_patient(self, patient_id):
        """Set the current patient context"""
        self.current_patient_id = patient_id
        
        for bill in self.patient_bills:
            if 'patient_info' in bill and bill['patient_info'].get('id') == patient_id:
                self.current_patient_data = bill['patient_info']
                break
        
        if self.current_patient_data is None:
            for p in self.patients:
                if p.get('patient_id') == patient_id:
                    self.current_patient_data = {
                        'id': p.get('patient_id'),
                        'name': p.get('name'),
                        'age': p.get('age'),
                        'gender': p.get('gender'),
                        'phone': p.get('phone'),
                        'blood_group': p.get('blood_group')
                    }
                    break
        
        self.update_patient_in_all_tabs()

    def get_current_patient_info(self):
        return self.current_patient_data or {'id': self.current_patient_id, 'name': 'Unknown'}

