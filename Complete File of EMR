    def book_appointment(self):
        pid = self.appt_patient_id.get()
        date = self.appt_date.get()
        time = self.appt_time.get()
        doctor = self.appt_doctor.get()
        department = self.appt_department.get()
        reason = self.appt_reason.get()
        appt_type = self.appt_type.get()
        
        if not pid or not date or not time:
            messagebox.showwarning("Warning", "Patient ID, date, and time are required")
            return
        
        patient_name = self.appt_patient_name.cget("text") or pid
        appt_id = f"APT{datetime.now().strftime('%Y%m%d%H%M%S')}"
        
        self.appointments.append({
            "appt_id": appt_id, "patient_id": pid, "patient_name": patient_name,
            "date": date, "time": time, "doctor": doctor, "department": department,
            "reason": reason, "type": appt_type, "status": "Scheduled",
            "booked_on": datetime.now().strftime("%Y-%m-%d %H:%M")
        })
        self.save_data_to_files()
        self.refresh_today_appointments()
        self.refresh_all_appointments()
        messagebox.showinfo("Success", f"Appointment booked: {appt_id}")

    def clear_appointment_form(self):
        self.appt_patient_id.delete(0, tk.END)
        self.appt_patient_name.config(text="")
        self.appt_date.delete(0, tk.END)
        self.appt_date.insert(0, datetime.now().strftime("%Y-%m-%d"))
        self.appt_time.set("09:00")
        self.appt_doctor.set('')
        self.appt_department.set('')
        self.appt_reason.delete(0, tk.END)
        self.appt_type.set("New Visit")

    def refresh_today_appointments(self):
        for item in self.appt_today_tree.get_children():
            self.appt_today_tree.delete(item)
        today = datetime.now().strftime("%Y-%m-%d")
        for appt in self.appointments:
            if appt.get('date') == today:
                self.appt_today_tree.insert("", "end", values=(
                    appt['time'], appt['patient_name'], appt.get('doctor', ''),
                    appt.get('department', ''), appt.get('reason', ''), appt.get('type', ''), appt['status']
                ), tags=(appt['status'],))
        self.appt_today_tree.tag_configure("Arrived", foreground="blue")
        self.appt_today_tree.tag_configure("Completed", foreground="green")
        self.appt_today_tree.tag_configure("Cancelled", foreground="red")

    def refresh_all_appointments(self):
        for item in self.appt_all_tree.get_children():
            self.appt_all_tree.delete(item)
        for appt in reversed(self.appointments):
            self.appt_all_tree.insert("", "end", values=(
                appt['date'], appt['time'], appt['patient_name'], appt.get('doctor', ''),
                appt.get('department', ''), appt.get('reason', ''), appt.get('type', ''), appt['status']
            ))

    def filter_appointments(self):
        date_filter = self.appt_filter_date.get()
        for item in self.appt_all_tree.get_children():
            self.appt_all_tree.delete(item)
        for appt in reversed(self.appointments):
            if appt.get('date') == date_filter:
                self.appt_all_tree.insert("", "end", values=(
                    appt['date'], appt['time'], appt['patient_name'], appt.get('doctor', ''),
                    appt.get('department', ''), appt.get('reason', ''), appt.get('type', ''), appt['status']
                ))

    def mark_appt_arrived(self):
        selected = self.appt_today_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Select an appointment")
            return
        values = self.appt_today_tree.item(selected[0])['values']
        time_val = values[0]
        patient = values[1]
        for appt in self.appointments:
            if appt.get('time') == time_val and appt['patient_name'] == patient and appt.get('status') == 'Scheduled':
                appt['status'] = 'Arrived'
                self.save_data_to_files()
                self.refresh_today_appointments()
                return

    def mark_appt_completed(self):
        selected = self.appt_today_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Select an appointment")
            return
        values = self.appt_today_tree.item(selected[0])['values']
        time_val = values[0]
        patient = values[1]
        for appt in self.appointments:
            if appt.get('time') == time_val and appt['patient_name'] == patient:
                appt['status'] = 'Completed'
                self.save_data_to_files()
                self.refresh_today_appointments()
                return

    def cancel_appointment(self):
        selected = self.appt_today_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Select an appointment")
            return
        values = self.appt_today_tree.item(selected[0])['values']
        time_val = values[0]
        patient = values[1]
        for appt in self.appointments:
            if appt.get('time') == time_val and appt['patient_name'] == patient:
                if messagebox.askyesno("Confirm", f"Cancel appointment for {patient}?"):
                    appt['status'] = 'Cancelled'
                    self.save_data_to_files()
                    self.refresh_today_appointments()
                    self.refresh_all_appointments()
                return

