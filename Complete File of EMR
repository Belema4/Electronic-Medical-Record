    def add_new_item(self):
        try:
            item_type = self.new_item_type.get()
            name = self.new_item_name.get().strip()
            price_str = self.new_item_price.get().strip()
            if not item_type or not name or not price_str:
                messagebox.showwarning("Warning", "Please fill all fields")
                return
            price = float(price_str)
            if item_type == "Drug":
                qty = int(self.new_item_qty.get())
                min_stock = int(self.new_item_min.get())
                category = self.new_item_category.get()
                self.drugs.append({"name": name, "price": price, "quantity": qty, "min_stock": min_stock, "category": category})
            elif item_type == "Procedure":
                self.procedures.append({"name": name, "price": price, "department": self.new_item_dept.get()})
            elif item_type == "Investigation":
                self.investigations.append({"name": name, "price": price, "department": self.new_item_dept.get()})
            elif item_type == "Other Charge":
                self.other_charges.append({"name": name, "price": price, "department": self.new_item_dept.get()})
            self.save_data_to_files()
            self.refresh_item_lists()
            self.new_item_name.delete(0, tk.END)
            self.new_item_price.delete(0, tk.END)
            messagebox.showinfo("Success", f"{item_type} added!")
        except ValueError:
            messagebox.showerror("Error", "Please enter valid numbers")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to add item: {str(e)}")

    def load_items_for_management(self, event=None):
        category = self.manage_category.get()
        if not category:
            return
        for item in self.manage_tree.get_children():
            self.manage_tree.delete(item)
        if category == "Drugs":
            for drug in self.drugs:
                self.manage_tree.insert("", "end", values=(drug['name'], f"N{drug['price']:,.2f}"))
        elif category == "Procedures":
            for proc in self.procedures:
                self.manage_tree.insert("", "end", values=(proc['name'], f"N{proc['price']:,.2f}"))
        elif category == "Investigations":
            for inv in self.investigations:
                self.manage_tree.insert("", "end", values=(inv['name'], f"N{inv['price']:,.2f}"))
        elif category == "Other Charges":
            for charge in self.other_charges:
                self.manage_tree.insert("", "end", values=(charge['name'], f"N{charge['price']:,.2f}"))

    def edit_selected_item(self):
        selected = self.manage_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Please select an item")
            return
        category = self.manage_category.get()
        item_name = self.manage_tree.item(selected[0])['values'][0]
        item = None
        if category == "Drugs":
            for drug in self.drugs:
                if drug['name'] == item_name: item = drug; break
        elif category == "Procedures":
            for proc in self.procedures:
                if proc['name'] == item_name: item = proc; break
        elif category == "Investigations":
            for inv in self.investigations:
                if inv['name'] == item_name: item = inv; break
        elif category == "Other Charges":
            for charge in self.other_charges:
                if charge['name'] == item_name: item = charge; break
        if not item:
            return
        dialog = tk.Toplevel(self.root)
        dialog.title(f"Edit {item_name}")
        dialog.geometry("300x200")
        ttk.Label(dialog, text="Name:").grid(row=0, column=0, padx=5, pady=5)
        name_entry = ttk.Entry(dialog, width=25)
        name_entry.insert(0, item['name'])
        name_entry.grid(row=0, column=1, padx=5, pady=5)
        ttk.Label(dialog, text="Price:").grid(row=1, column=0, padx=5, pady=5)
        price_entry = ttk.Entry(dialog, width=15)
        price_entry.insert(0, str(item['price']))
        price_entry.grid(row=1, column=1, padx=5, pady=5)
        def save_changes():
            item['name'] = name_entry.get()
            item['price'] = float(price_entry.get())
            self.save_data_to_files()
            self.load_items_for_management()
            dialog.destroy()
            messagebox.showinfo("Success", "Item updated!")
        ttk.Button(dialog, text="Save", command=save_changes).grid(row=2, column=0, columnspan=2, pady=20)

    def delete_selected_item(self):
        selected = self.manage_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Please select an item")
            return
        category = self.manage_category.get()
        item_name = self.manage_tree.item(selected[0])['values'][0]
        if not messagebox.askyesno("Confirm", f"Delete {item_name}?"):
            return
        if category == "Drugs":
            self.drugs = [d for d in self.drugs if d['name'] != item_name]
        elif category == "Procedures":
            self.procedures = [p for p in self.procedures if p['name'] != item_name]
        elif category == "Investigations":
            self.investigations = [i for i in self.investigations if i['name'] != item_name]
        elif category == "Other Charges":
            self.other_charges = [c for c in self.other_charges if c['name'] != item_name]
        self.save_data_to_files()
        self.load_items_for_management()
        messagebox.showinfo("Success", "Item deleted!")

