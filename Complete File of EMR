    def load_current_patient_to_ai(self):
        if self.current_patient_data:
            self.ai_patient_id.delete(0, tk.END)
            self.ai_patient_id.insert(0, self.current_patient_data.get('id', ''))
            self.ai_patient_name.config(text=self.current_patient_data.get('name', ''))
            self.current_ai_patient = self.current_patient_data
            self.generate_ai_summary()
        else:
            messagebox.showwarning("Warning", "No patient selected. Please select a patient first.")

    def generate_ai_summary(self):
        pid = self.ai_patient_id.get()
        if not pid:
            messagebox.showwarning("Warning", "Please load a patient first")
            return
        
        patient_data = None
        for bill in self.patient_bills:
            if 'patient_info' in bill and bill['patient_info'].get('id') == pid:
                patient_data = bill['patient_info']
                break
        
        if not patient_data:
            messagebox.showwarning("Not Found", "Patient not found")
            return
        
        patient_emr = [r for r in self.emr_records if r.get('patient_id') == pid]
        patient_labs = [l for l in self.lab_tests if l.get('patient_id') == pid]
        
        if hasattr(self, 'radiology_requests'):
            patient_rad = [r for r in self.radiology_requests if r.get('patient_id') == pid]
        else:
            patient_rad = []
        
        patient_prescriptions = [p for p in self.prescriptions if p.get('patient_id') == pid]
        
        summary = ClinicalDecisionSupport.generate_patient_summary(
            patient_data,
            patient_emr,
            patient_labs,
            patient_rad,
            patient_prescriptions
        )
        
        self.ai_summary_text.delete(1.0, tk.END)
        self.ai_summary_text.insert(1.0, summary)
        self.current_ai_patient = patient_data
        
        self.calculate_news_from_emr()

    def calculate_news_from_emr(self):
        pid = self.ai_patient_id.get()
        if not pid:
            return
        
        patient_emr = [r for r in self.emr_records if r.get('patient_id') == pid]
        
        if not patient_emr:
            self.news_details_text.delete(1.0, tk.END)
            self.news_details_text.insert(1.0, "No EMR records found for this patient")
            self.news_score_label.config(text="Score: --")
            self.news_risk_label.config(text="Risk Level: --")
            return
        
        latest = patient_emr[-1]
        
        vitals = {
            'respiratory_rate': latest.get('respiratory_rate', 0),
            'spo2': latest.get('spo2', 0),
            'temperature': latest.get('temperature', 0),
            'systolic_bp': latest.get('systolic_bp', 0),
            'heart_rate': latest.get('heart_rate', 0),
            'consciousness': latest.get('consciousness', 'alert')
        }
        
        news = ClinicalDecisionSupport.calculate_news(vitals)
        
        self.news_score_label.config(text=f"Score: {news['score']}")
        self.news_risk_label.config(text=f"Risk Level: {news['risk_level']}")
        
        details = f"NEWS Calculation Details:\n{'-'*40}\n"
        for exp in news['explanations']:
            details += f"• {exp}\n"
        details += f"\nTotal Score: {news['score']}\n"
        details += f"Risk Category: {news['risk_level']}"
        
        self.news_details_text.delete(1.0, tk.END)
        self.news_details_text.insert(1.0, details)

    def export_ai_summary(self):
        summary = self.ai_summary_text.get(1.0, tk.END).strip()
        if not summary:
            messagebox.showwarning("Warning", "No summary to export")
            return
        
        filename = filedialog.asksaveasfilename(
            defaultextension=".txt",
            filetypes=[("Text files", "*.txt"), ("All files", "*.*")],
            initialfile=f"ai_summary_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
        )
        
        if filename:
            try:
                with open(filename, "w", encoding="utf-8") as f:
                    f.write(summary)
                messagebox.showinfo("Success", f"Summary exported to {filename}")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to export: {e}")

