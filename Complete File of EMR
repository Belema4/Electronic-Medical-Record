    def extract_ml_features(self):
        pid = self.ml_patient_id.get()
        if not pid:
            messagebox.showwarning("Warning", "Please load a patient first")
            return
        
        patient_data = None
        for bill in self.patient_bills:
            if 'patient_info' in bill and bill['patient_info'].get('id') == pid:
                patient_data = bill['patient_info']
                break
        
        if not patient_data:
            messagebox.showwarning("Not Found", "Patient not found")
            return
        
        patient_emr = [r for r in self.emr_records if r.get('patient_id') == pid]
        patient_labs = [l for l in self.lab_tests if l.get('patient_id') == pid]
        patient_prescriptions = [p for p in self.prescriptions if p.get('patient_id') == pid]
        
        if hasattr(self, 'radiology_requests'):
            patient_rad = [r for r in self.radiology_requests if r.get('patient_id') == pid]
        else:
            patient_rad = []
        
        vitals = {}
        if patient_emr:
            latest = patient_emr[-1]
            vitals = {
                'heart_rate': latest.get('heart_rate', 0),
                'respiratory_rate': latest.get('respiratory_rate', 0),
                'temperature': latest.get('temperature', 0),
                'systolic_bp': latest.get('systolic_bp', 0),
                'diastolic_bp': latest.get('diastolic_bp', 0),
                'spo2': latest.get('spo2', 0)
            }
        
        features = MLDataExtractor.extract_features(
            patient_data,
            patient_emr,
            patient_labs,
            patient_rad,
            vitals,
            patient_prescriptions
        )
        
        feature_text = "=== ML FEATURES EXTRACTED ===\n\n"
        feature_text += f"Patient ID: {features.get('patient_id', 'N/A')}\n"
        feature_text += f"Age: {features.get('age', 'N/A')}\n"
        feature_text += f"Gender: {'Male' if features.get('gender') == 1 else 'Female'}\n"
        feature_text += f"Blood Group: {features.get('blood_group', 'N/A')}\n"
        feature_text += f"NEWS Score: {features.get('news_score', 'N/A')}\n"
        feature_text += f"NEWS Risk: {features.get('news_risk', 'N/A')}\n"
        feature_text += f"Risk Score: {features.get('risk_score', 'N/A')}\n"
        feature_text += f"Overall Risk: {features.get('overall_risk', 'N/A')}\n"
        feature_text += f"Number of Hospital Visits: {features.get('num_hospital_visits', 0)}\n"
        feature_text += f"Number of Lab Tests: {features.get('num_lab_tests', 0)}\n"
        feature_text += f"Has Radiology: {features.get('has_radiology', False)}\n"
        feature_text += f"Number of Prescriptions: {features.get('num_prescriptions', 0)}\n\n"
        
        if features.get('diagnoses'):
            feature_text += "Diagnoses:\n"
            for dx in features['diagnoses'][:5]:
                feature_text += f"  • {dx}\n"
        
        if features.get('lab_tests'):
            feature_text += "\nRecent Lab Results:\n"
            for lab in features['lab_tests'][:5]:
                feature_text += f"  • {lab.get('test_name')}: {lab.get('result')}\n"
        
        self.ml_features_text.delete(1.0, tk.END)
        self.ml_features_text.insert(1.0, feature_text)
        
        pathology = MLDataExtractor.extract_pathology_details(
            patient_data,
            patient_labs,
            patient_rad
        )
        
        path_text = "=== PATHOLOGICAL DETAILS ===\n\n"
        path_text += f"Overall Risk Level: {pathology.get('overall_risk', 'Normal')}\n\n"
        
        if pathology.get('biomarkers'):
            path_text += "Biomarkers:\n"
            for marker, value in pathology['biomarkers'].items():
                path_text += f"  • {marker}: {value}\n"
        
        if pathology.get('risk_factors'):
            path_text += "\nRisk Factors Identified:\n"
            for factor in pathology['risk_factors']:
                path_text += f"  • {factor}\n"
        
        if pathology.get('lab_results'):
            path_text += "\nAbnormal Lab Results:\n"
            for lab in pathology['lab_results']:
                if lab.get('is_abnormal'):
                    path_text += f"  • {lab['test']}: {lab['result']} {lab.get('unit', '')} (Ref: {lab.get('reference_range', 'N/A')})\n"
        
        self.ml_path_text.delete(1.0, tk.END)
        self.ml_path_text.insert(1.0, path_text)
        
        self.ml_features_data = features
        self.ml_pathology_data = pathology
        self.current_ml_patient = patient_data

