class ImageCaptureDialog:
    """Dialog for capturing/uploading patient results with camera support"""
    
    def __init__(self, parent, patient_id, result_type="Lab Result"):
        self.parent = parent
        self.patient_id = patient_id
        self.result_type = result_type
        self.captured_image = None
        self.camera = None
        self.is_running = False
        self.dialog = None
        self.image_label = None
        self.camera_btn = None
        self.capture_btn = None
        self.close_camera_btn = None
        self.upload_btn = None
        self.save_btn = None
        self.desc_entry = None
        self.gallery_btn = None
        self.photo = None
        self.document_path = None
        self.original_filename = None
        
        self.dialog = tk.Toplevel(parent)
        self.dialog.title(f"Capture {result_type} - Patient: {patient_id}")
        self.dialog.geometry("800x650")
        self.dialog.transient(parent)
        self.dialog.grab_set()
        
        self.create_widgets()
        
    def create_widgets(self):
        control_frame = ttk.Frame(self.dialog)
        control_frame.pack(fill='x', padx=10, pady=5)
        
        ttk.Label(control_frame, text=f"Patient: {self.patient_id}", font=('Arial', 12, 'bold')).pack(side='left', padx=5)
        ttk.Label(control_frame, text=f"Type: {self.result_type}", font=('Arial', 10)).pack(side='left', padx=10)
        
        self.image_label = ttk.Label(self.dialog, relief='solid', borderwidth=2, background='#f0f0f0')
        self.image_label.pack(fill='both', expand=True, padx=10, pady=5)
        self.image_label.config(text="No image captured.\n\nClick 'Open Camera' or 'Choose from Gallery' to add a result.", 
                               font=('Arial', 12), foreground='gray')
        
        btn_frame = ttk.Frame(self.dialog)
        btn_frame.pack(fill='x', padx=10, pady=10)
        
        if CAMERA_AVAILABLE and PIL_AVAILABLE:
            self.camera_btn = ttk.Button(btn_frame, text="📷 Open Camera", command=self.open_camera)
            self.camera_btn.pack(side='left', padx=5)
            
            self.capture_btn = ttk.Button(btn_frame, text="📸 Capture Photo", command=self.capture_photo, state='disabled')
            self.capture_btn.pack(side='left', padx=5)
            
            self.close_camera_btn = ttk.Button(btn_frame, text="❌ Close Camera", command=self.close_camera, state='disabled')
            self.close_camera_btn.pack(side='left', padx=5)
        
        self.gallery_btn = ttk.Button(btn_frame, text="🖼️ Choose from Gallery", command=self.choose_from_gallery)
        self.gallery_btn.pack(side='left', padx=5)
        
        self.upload_btn = ttk.Button(btn_frame, text="📁 Upload File", command=self.upload_file)
        self.upload_btn.pack(side='left', padx=5)
        
        self.save_btn = ttk.Button(btn_frame, text="💾 Save Result", command=self.save_result, state='disabled')
        self.save_btn.pack(side='left', padx=5)
        
        self.cancel_btn = ttk.Button(btn_frame, text="✖️ Cancel", command=self.dialog.destroy)
        self.cancel_btn.pack(side='right', padx=5)
        
        desc_frame = ttk.LabelFrame(self.dialog, text="Description", padding=10)
        desc_frame.pack(fill='x', padx=10, pady=5)
        
        self.desc_entry = ttk.Entry(desc_frame, width=80)
        self.desc_entry.pack(fill='x', pady=5)
        self.desc_entry.insert(0, f"{self.result_type} for patient {self.patient_id}")
        
    def open_camera(self):
        if not CAMERA_AVAILABLE:
            messagebox.showerror("Error", "Camera not available. Please install OpenCV.")
            return
        
        if not PIL_AVAILABLE:
            messagebox.showerror("Error", "PIL not available. Please install Pillow.")
            return
        
        try:
            self.camera = cv2.VideoCapture(0)
            if not self.camera.isOpened():
                messagebox.showerror("Error", "Could not open camera. Please check if camera is connected.")
                return
            
            self.is_running = True
            if self.camera_btn:
                self.camera_btn.config(state='disabled')
            if self.capture_btn:
                self.capture_btn.config(state='normal')
            if self.close_camera_btn:
                self.close_camera_btn.config(state='normal')
            if self.gallery_btn:
                self.gallery_btn.config(state='disabled')
            if self.upload_btn:
                self.upload_btn.config(state='disabled')
            
            self.update_camera_feed()
            
        except Exception as e:
            messagebox.showerror("Error", f"Failed to open camera: {str(e)}")
    
    def update_camera_feed(self):
        if not self.is_running or self.camera is None or self.image_label is None:
            return
        
        try:
            ret, frame = self.camera.read()
            if ret:
                frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                image = Image.fromarray(frame_rgb)
                image.thumbnail((700, 500), Image.LANCZOS)
                
                self.photo = ImageTk.PhotoImage(image)
                self.image_label.config(image=self.photo, text="")
                self.image_label.image = self.photo
                self.current_image = frame_rgb
            
            if self.is_running:
                self.dialog.after(50, self.update_camera_feed)
        except Exception as e:
            print(f"Camera feed error: {e}")
            self.close_camera()
    
    def capture_photo(self):
        if hasattr(self, 'current_image') and self.current_image is not None:
            image = Image.fromarray(self.current_image)
            self.captured_image = image
            if self.save_btn:
                self.save_btn.config(state='normal')
            
            # Display captured image
            display_img = image.copy()
            display_img.thumbnail((400, 300), Image.LANCZOS)
            self.photo = ImageTk.PhotoImage(display_img)
            self.image_label.config(image=self.photo, text="")
            self.image_label.image = self.photo
            
            # Stop camera feed after capture
            self.is_running = False
            if self.camera:
                self.camera.release()
                self.camera = None
            
            if self.capture_btn:
                self.capture_btn.config(state='disabled')
            if self.close_camera_btn:
                self.close_camera_btn.config(state='disabled')
            if self.camera_btn:
                self.camera_btn.config(state='normal')
            if self.gallery_btn:
                self.gallery_btn.config(state='normal')
            if self.upload_btn:
                self.upload_btn.config(state='normal')
            
            messagebox.showinfo("Success", "Photo captured! You can add a description and save.")
    
    def choose_from_gallery(self):
        """Open gallery/file picker to choose an image"""
        filename = filedialog.askopenfilename(
            title="Choose Image from Gallery",
            filetypes=[
                ("Image files", "*.jpg *.jpeg *.png *.bmp *.gif *.tiff *.webp"),
                ("All files", "*.*")
            ]
        )
        
        if filename:
            try:
                if not PIL_AVAILABLE:
                    messagebox.showerror("Error", "PIL not available. Please install Pillow.")
                    return
                    
                # Open and display the image
                image = Image.open(filename)
                self.captured_image = image
                if self.save_btn:
                    self.save_btn.config(state='normal')
                
                # Resize for display
                display_img = image.copy()
                display_img.thumbnail((500, 400), Image.LANCZOS)
                self.photo = ImageTk.PhotoImage(display_img)
                self.image_label.config(image=self.photo, text="")
                self.image_label.image = self.photo
                
                # Store original filename for reference
                self.original_filename = os.path.basename(filename)
                
                messagebox.showinfo("Success", f"Image loaded from gallery!\nFile: {self.original_filename}")
                
            except Exception as e:
                messagebox.showerror("Error", f"Failed to load image: {str(e)}")
    
    def upload_file(self):
        """Upload any file (image or document)"""
        filename = filedialog.askopenfilename(
            title="Upload File",
            filetypes=[
                ("All supported", "*.jpg *.jpeg *.png *.bmp *.gif *.pdf *.doc *.docx *.txt *.tiff *.webp"),
                ("Image files", "*.jpg *.jpeg *.png *.bmp *.gif *.tiff *.webp"),
                ("PDF files", "*.pdf"),
                ("Word files", "*.doc *.docx"),
                ("Text files", "*.txt"),
                ("All files", "*.*")
            ]
        )
        
        if filename:
            try:
                # Check if it's an image file
                file_ext = os.path.splitext(filename)[1].lower()
                image_extensions = ['.jpg', '.jpeg', '.png', '.bmp', '.gif', '.tiff', '.webp']
                
                if file_ext in image_extensions and PIL_AVAILABLE:
                    # It's an image, display it
                    image = Image.open(filename)
                    self.captured_image = image
                    if self.save_btn:
                        self.save_btn.config(state='normal')
                    
                    display_img = image.copy()
                    display_img.thumbnail((500, 400), Image.LANCZOS)
                    self.photo = ImageTk.PhotoImage(display_img)
                    self.image_label.config(image=self.photo, text="")
                    self.image_label.image = self.photo
                    
                    self.original_filename = os.path.basename(filename)
                    messagebox.showinfo("Success", f"Image uploaded!\nFile: {self.original_filename}")
                else:
                    # It's a document, store it for saving
                    self.document_path = filename
                    self.captured_image = None
                    if self.save_btn:
                        self.save_btn.config(state='normal')
                    
                    if PIL_AVAILABLE:
                        self.image_label.config(text=f"Document uploaded:\n{os.path.basename(filename)}\n\nClick 'Save Result' to save.")
                    else:
                        self.image_label.config(text=f"Document uploaded:\n{os.path.basename(filename)}")
                    self.image_label.image = None
                    
                    self.original_filename = os.path.basename(filename)
                    messagebox.showinfo("Success", f"Document uploaded!\nFile: {self.original_filename}")
                
            except Exception as e:
                messagebox.showerror("Error", f"Failed to upload file: {str(e)}")
    
    def close_camera(self):
        self.is_running = False
        if self.camera:
            self.camera.release()
            self.camera = None
        
        if self.camera_btn:
            self.camera_btn.config(state='normal')
        if self.capture_btn:
            self.capture_btn.config(state='disabled')
        if self.close_camera_btn:
            self.close_camera_btn.config(state='disabled')
        if self.gallery_btn:
            self.gallery_btn.config(state='normal')
        if self.upload_btn:
            self.upload_btn.config(state='normal')
        
        if self.image_label and not self.captured_image and not self.document_path:
            self.image_label.config(text="Camera closed.\n\nClick 'Open Camera' or 'Choose from Gallery' to add a result.",
                                   font=('Arial', 12), foreground='gray')
            self.image_label.image = None
    
    def save_result(self):
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        result_id = f"RESULT_{self.patient_id}_{timestamp}"
        
        results_dir = "patient_results"
        if not os.path.exists(results_dir):
            os.makedirs(results_dir)
        
        # Handle different types of files
        if hasattr(self, 'document_path') and self.document_path:
            # It's a document file, copy it
            file_ext = os.path.splitext(self.document_path)[1]
            new_filename = f"{result_id}{file_ext}"
            new_path = os.path.join(results_dir, new_filename)
            shutil.copy2(self.document_path, new_path)
            
            metadata = {
                "result_id": result_id,
                "patient_id": self.patient_id,
                "result_type": self.result_type,
                "description": self.desc_entry.get() if self.desc_entry else "",
                "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "file_path": new_path,
                "file_type": "Document",
                "original_filename": getattr(self, 'original_filename', '')
            }
        elif self.captured_image:
            # It's an image
            image_path = os.path.join(results_dir, f"{result_id}.jpg")
            self.captured_image.save(image_path, "JPEG", quality=85)
            
            metadata = {
                "result_id": result_id,
                "patient_id": self.patient_id,
                "result_type": self.result_type,
                "description": self.desc_entry.get() if self.desc_entry else "",
                "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "image_path": image_path,
                "file_type": "Image",
                "original_filename": getattr(self, 'original_filename', '')
            }
        else:
            messagebox.showwarning("Warning", "No image or document to save.")
            return
        
        # Save metadata
        results_file = os.path.join(results_dir, "results_metadata.json")
        try:
            if os.path.exists(results_file):
                with open(results_file, "r", encoding="utf-8") as f:
                    results_data = json.load(f)
            else:
                results_data = []
            
            results_data.append(metadata)
            
            with open(results_file, "w", encoding="utf-8") as f:
                json.dump(results_data, f, indent=2, ensure_ascii=False)
            
        except Exception as e:
            messagebox.showerror("Error", f"Failed to save metadata: {str(e)}")
        
        self.close_camera()
        messagebox.showinfo("Success", f"Result saved!\nID: {result_id}")
        self.dialog.destroy()

