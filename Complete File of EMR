    def generate_financial_report(self, date_from, date_to, department):
        try:
            filtered_bills = []
            for bill in self.patient_bills:
                if 'timestamp' in bill:
                    bill_date = bill['timestamp'].split()[0]
                    if date_from <= bill_date <= date_to:
                        if department == "All" or any(item.get('department') == department for item in bill.get('items', [])):
                            filtered_bills.append(bill)
            total_revenue = sum(bill.get('total', 0) for bill in filtered_bills)
            total_bills = len(filtered_bills)
            categories = {}
            for bill in filtered_bills:
                for item in bill.get('items', []):
                    cat = item.get('category', 'Other')
                    categories[cat] = categories.get(cat, 0) + item.get('total', 0)
            report = f"FINANCIAL REPORT\nPeriod: {date_from} to {date_to}\nDepartment: {department}\n{'='*50}\n\n"
            report += f"Total Revenue: N{total_revenue:,.2f}\nTotal Bills: {total_bills}\n"
            report += f"Average per Bill: N{total_revenue/max(total_bills,1):,.2f}\n\nRevenue by Category:\n{'-'*30}\n"
            for cat, amount in categories.items():
                percentage = (amount / total_revenue * 100) if total_revenue > 0 else 0
                report += f"{cat:20} N{amount:12,.2f} ({percentage:.1f}%)\n"
            report += f"\nTop 5 Bills:\n{'-'*50}\n"
            top_bills = sorted(filtered_bills, key=lambda x: x.get('total', 0), reverse=True)[:5]
            for i, bill in enumerate(top_bills, 1):
                patient = bill.get('patient_info', {})
                report += f"{i}. {patient.get('name', 'Unknown'):20} N{bill.get('total',0):12,.2f} {bill.get('timestamp','')[:10]}\n"
            self.report_text.insert(1.0, report)
        except Exception as e:
            self.report_text.insert(1.0, f"Error generating report: {str(e)}")

    def generate_patient_report(self, date_from, date_to, department):
        try:
            patients = []
            if os.path.exists("patients.json"):
                with open("patients.json", "r", encoding="utf-8") as f:
                    patients = json.load(f)
            filtered_patients = [p for p in patients if 'registration_date' in p and date_from <= p['registration_date'][:10] <= date_to]
            total_patients = len(filtered_patients)
            gender_count = {"Male": 0, "Female": 0, "Other": 0}
            age_groups = {"0-18": 0, "19-35": 0, "36-60": 0, "60+": 0}
            for patient in filtered_patients:
                gender = patient.get('gender', 'Other')
                gender_count[gender if gender in gender_count else "Other"] += 1
                try:
                    dob = patient.get('dob', '')
                    if dob:
                        age = datetime.now().year - int(dob[:4])
                        if age <= 18: age_groups["0-18"] += 1
                        elif age <= 35: age_groups["19-35"] += 1
                        elif age <= 60: age_groups["36-60"] += 1
                        else: age_groups["60+"] += 1
                except (ValueError, TypeError):
                    pass
            report = f"PATIENT STATISTICS REPORT\nPeriod: {date_from} to {date_to}\n{'='*50}\n\n"
            report += f"Total New Patients: {total_patients}\n\nGender Distribution:\n{'-'*30}\n"
            for gender, count in gender_count.items():
                if count > 0:
                    report += f"{gender:10} {count:5} patients ({count/total_patients*100 if total_patients>0 else 0:.1f}%)\n"
            report += f"\nAge Distribution:\n{'-'*30}\n"
            for group, count in age_groups.items():
                if count > 0:
                    report += f"{group:10} {count:5} patients ({count/total_patients*100 if total_patients>0 else 0:.1f}%)\n"
            blood_groups = {}
            for p in filtered_patients:
                bg = p.get('blood_group', 'Unknown')
                blood_groups[bg] = blood_groups.get(bg, 0) + 1
            if blood_groups:
                report += f"\nBlood Group Distribution:\n{'-'*30}\n"
                for bg, count in sorted(blood_groups.items()):
                    report += f"{bg:5} {count:5} patients ({count/total_patients*100 if total_patients>0 else 0:.1f}%)\n"
            self.report_text.insert(1.0, report)
        except Exception as e:
            self.report_text.insert(1.0, f"Error generating report: {str(e)}")

    def generate_inventory_report(self):
        try:
            total_drugs = len(self.drugs)
            total_value = sum(d['price'] * d.get('quantity', 0) for d in self.drugs)
            out_of_stock = [d for d in self.drugs if d.get('quantity', 0) == 0]
            low_stock = [d for d in self.drugs if 0 < d.get('quantity', 0) <= d.get('min_stock', 10)]
            categories = {}
            for drug in self.drugs:
                cat = drug.get('category', 'Uncategorized')
                if cat not in categories: categories[cat] = []
                categories[cat].append(drug)
            report = f"DRUG INVENTORY REPORT\nGenerated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n{'='*50}\n\n"
            report += f"Total Drugs: {total_drugs}\nTotal Inventory Value: N{total_value:,.2f}\n"
            report += f"Out of Stock: {len(out_of_stock)} items\nLow Stock: {len(low_stock)} items\n\n"
            report += f"Stock Status by Category:\n{'-'*50}\n"
            for cat, drugs in categories.items():
                cat_out = len([d for d in drugs if d.get('quantity', 0) == 0])
                cat_low = len([d for d in drugs if 0 < d.get('quantity', 0) <= d.get('min_stock', 10)])
                report += f"{cat:20} Total: {len(drugs):3} | Out: {cat_out:2} | Low: {cat_low:2}\n"
            if out_of_stock or low_stock:
                report += f"\nCRITICAL ITEMS:\n{'-'*50}\n"
                if out_of_stock:
                    report += "\nOUT OF STOCK:\n"
                    for drug in out_of_stock:
                        report += f"  - {drug['name']}\n"
                if low_stock:
                    report += "\nLOW STOCK:\n"
                    for drug in low_stock:
                        report += f"  - {drug['name']}: {drug.get('quantity', 0)} left\n"
            today = datetime.now()
            expiring_soon = []
            for drug in self.drugs:
                expiry = drug.get('expiry_date', '')
                if expiry:
                    try:
                        expiry_date = datetime.strptime(expiry, "%Y-%m-%d")
                        days_left = (expiry_date - today).days
                        if 0 <= days_left <= 90:
                            expiring_soon.append((drug['name'], expiry, days_left))
                    except ValueError:
                        pass
            if expiring_soon:
                report += f"\nEXPIRING SOON (next 90 days):\n{'-'*50}\n"
                for name, expiry, days in expiring_soon:
                    report += f"  - {name}: Expires {expiry} ({days} days)\n"
            self.report_text.insert(1.0, report)
        except Exception as e:
            self.report_text.insert(1.0, f"Error generating report: {str(e)}")

    def generate_billing_details(self, date_from, date_to, department):
        try:
            filtered_bills = [b for b in self.patient_bills if 'timestamp' in b and date_from <= b['timestamp'].split()[0] <= date_to]
            if department != "All":
                filtered_bills = [b for b in filtered_bills if any(item.get('department') == department for item in b.get('items', []))]
            report = f"BILLING DETAILS REPORT\nPeriod: {date_from} to {date_to}\nDepartment: {department}\n{'='*50}\n\n"
            total_revenue = 0
            bill_count = 0
            for bill in filtered_bills:
                patient = bill.get('patient_info', {})
                report += f"Bill ID: {bill.get('bill_id', 'N/A')}\nDate: {bill.get('timestamp', '')}\n"
                report += f"Patient: {patient.get('name', 'Unknown')} (ID: {patient.get('id', 'N/A')})\nItems:\n"
                for item in bill.get('items', []):
                    report += f"  - {item.get('name', 'Unknown')}: {item.get('quantity', 1)} x N{item.get('unit_price',0):,.2f} = N{item.get('total',0):,.2f}\n"
                report += f"Total: N{bill.get('total', 0):,.2f}\n{'-'*50}\n\n"
                total_revenue += bill.get('total', 0)
                bill_count += 1
            report += f"\nSUMMARY:\nTotal Bills: {bill_count}\nTotal Revenue: N{total_revenue:,.2f}\n"
            report += f"Average per Bill: N{total_revenue/max(bill_count,1):,.2f}\n"
            self.report_text.insert(1.0, report)
        except Exception as e:
            self.report_text.insert(1.0, f"Error generating report: {str(e)}")

    def generate_department_report(self, date_from, date_to):
        try:
            department_stats = {}
            for bill in self.patient_bills:
                if 'timestamp' in bill and date_from <= bill['timestamp'].split()[0] <= date_to:
                    for item in bill.get('items', []):
                        dept = item.get('department', 'General')
                        amount = item.get('total', 0)
                        if dept not in department_stats:
                            department_stats[dept] = {'revenue': 0, 'count': 0, 'patients': set(), 'items': {}}
                        stats = department_stats[dept]
                        stats['revenue'] += amount
                        stats['count'] += 1
                        if 'patient_info' in bill:
                            stats['patients'].add(bill['patient_info'].get('id', ''))
                        item_name = item.get('name', 'Unknown')
                        stats['items'][item_name] = stats['items'].get(item_name, 0) + 1
            report = f"DEPARTMENT PERFORMANCE REPORT\nPeriod: {date_from} to {date_to}\n{'='*50}\n\n"
            for dept, stats in sorted(department_stats.items(), key=lambda x: x[1]['revenue'], reverse=True):
                patient_count = len(stats['patients'])
                avg_rev = stats['revenue'] / max(stats['count'], 1)
                report += f"{dept.upper()}:\n  Revenue: N{stats['revenue']:,.2f}\n  Transactions: {stats['count']}\n"
                report += f"  Unique Patients: {patient_count}\n  Avg per Transaction: N{avg_rev:,.2f}\n"
                if stats['items']:
                    top_items = sorted(stats['items'].items(), key=lambda x: x[1], reverse=True)[:3]
                    report += f"  Top Items:\n"
                    for item_name, count in top_items:
                        report += f"    - {item_name}: {count} times\n"
                report += "\n"
            total_revenue = sum(s['revenue'] for s in department_stats.values())
            report += f"\nTOTAL ACROSS ALL DEPARTMENTS: N{total_revenue:,.2f}\n"
            self.report_text.insert(1.0, report)
        except Exception as e:
            self.report_text.insert(1.0, f"Error generating report: {str(e)}")

    def export_report(self):
        try:
            report_text = self.report_text.get(1.0, tk.END).strip()
            if not report_text:
                messagebox.showwarning("Warning", "No report to export")
                return
            filename = filedialog.asksaveasfilename(
                defaultextension=".xlsx",
                filetypes=[("Excel files", "*.xlsx"), ("All files", "*.*")],
                initialfile=f"report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.xlsx"
            )
            if filename:
                lines = report_text.split('\n')
                data = []
                current_section = ""
                for line in lines:
                    if line.strip() and not line.startswith('=') and not line.startswith('-'):
                        if line.isupper() or (':' in line and line.index(':') < 20):
                            current_section = line
                        else:
                            data.append([current_section, line])
                df = pd.DataFrame(data, columns=['Section', 'Content'])
                with pd.ExcelWriter(filename, engine='openpyxl') as writer:
                    df.to_excel(writer, sheet_name='Report', index=False)
                    worksheet = writer.sheets['Report']
                    for column in worksheet.columns:
                        max_length = 0
                        column_letter = column[0].column_letter
                        for cell in column:
                            try:
                                if len(str(cell.value)) > max_length:
                                    max_length = len(str(cell.value))
                            except Exception:
                                pass
                        worksheet.column_dimensions[column_letter].width = min(max_length + 2, 50)
                messagebox.showinfo("Success", f"Report exported to {filename}")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to export report: {str(e)}")

    def print_report(self):
        try:
            report_text = self.report_text.get(1.0, tk.END).strip()
            if not report_text:
                messagebox.showwarning("Warning", "No report to print")
                return
            html_content = f"""<html><head><title>Hospital Report</title>
            <style>body {{ font-family: Arial, sans-serif; margin: 20px; }}
            h1 {{ color: #2c3e50; border-bottom: 2px solid #3498db; }}
            .header {{ text-align: center; margin-bottom: 30px; }}
            .content {{ line-height: 1.6; }} pre {{ white-space: pre-wrap; }}</style>
            </head><body><div class="header"><h1>HMG HOSPITAL REPORT</h1>
            <p>Generated on {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}</p></div>
            <div class="content"><pre>{report_text}</pre></div></body></html>"""
            temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.html', delete=False, encoding='utf-8')
            temp_file.write(html_content)
            temp_file.close()
            import webbrowser
            webbrowser.open(f'file://{temp_file.name}')
        except Exception as e:
            messagebox.showerror("Error", f"Failed to print report: {str(e)}")

