    def order_lab_test(self):
        pid = self.lab_patient_id.get()
        test_name = self.lab_test_combo.get()
        doctor = self.lab_doctor.get()
        if not pid or not test_name:
            messagebox.showwarning("Warning", "Select patient and test")
            return
        test_id = f"LAB{datetime.now().strftime('%Y%m%d%H%M%S')}"
        patient_name = self.lab_patient_name.cget("text") or pid
        self.lab_tests.append({
            "test_id": test_id, "patient_id": pid, "patient_name": patient_name,
            "test_name": test_name, "doctor": doctor,
            "date_ordered": datetime.now().strftime("%Y-%m-%d %H:%M"),
            "status": "Pending", "result": "", "unit": "", "reference": "", "interpretation": "",
            "billed": False
        })
        self.save_data_to_files()
        self.refresh_lab_pending()
        self.lab_notes.delete(1.0, tk.END)
        messagebox.showinfo("Success", f"Test ordered: {test_id}")

    def refresh_lab_pending(self):
        for item in self.lab_pending_tree.get_children():
            self.lab_pending_tree.delete(item)
        for test in self.lab_tests:
            if test.get('status') == 'Pending':
                self.lab_pending_tree.insert("", "end", values=(
                    test['test_id'], test['patient_name'], test['test_name'],
                    test.get('doctor', ''), test['date_ordered'], test['status']
                ))

    def enter_lab_results(self):
        selected = self.lab_pending_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Select a pending test")
            return
        values = self.lab_pending_tree.item(selected[0])['values']
        self.current_lab_test_id = values[0]
        messagebox.showinfo("Info", f"Enter results for {self.current_lab_test_id}")

    def save_lab_results(self):
        if not hasattr(self, 'current_lab_test_id') or not self.current_lab_test_id:
            messagebox.showwarning("Warning", "Select a test from Pending list first")
            return
        for test in self.lab_tests:
            if test['test_id'] == self.current_lab_test_id:
                test['result'] = self.lab_result_value.get()
                test['unit'] = self.lab_result_unit.get()
                test['reference'] = self.lab_ref_range.get()
                test['interpretation'] = self.lab_interpretation.get(1.0, tk.END).strip()
                test['status'] = 'Completed'
                test['date_completed'] = datetime.now().strftime("%Y-%m-%d %H:%M")
                self.save_data_to_files()
                self.refresh_lab_pending()
                self.refresh_lab_results()
                self.lab_result_value.delete(0, tk.END)
                self.lab_result_unit.delete(0, tk.END)
                self.lab_ref_range.delete(0, tk.END)
                self.lab_interpretation.delete(1.0, tk.END)
                self.current_lab_test_id = ""
                messagebox.showinfo("Success", "Results saved!")
                return

    def refresh_lab_results(self):
        for item in self.lab_results_tree.get_children():
            self.lab_results_tree.delete(item)
        for test in reversed(self.lab_tests):
            if test.get('status') == 'Completed':
                self.lab_results_tree.insert("", "end", values=(
                    test.get('date_completed', ''), test['patient_name'], test['test_name'],
                    test.get('result', ''), test.get('unit', ''), test.get('reference', ''),
                    test.get('interpretation', '')
                ))

