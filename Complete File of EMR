class MLDataExtractor:
    """Extract structured data for machine learning and clinical decision making"""
    
    @staticmethod
    def extract_features(patient_data, emr_records, lab_results, radiology_reports, vitals, prescriptions):
        """Extract features for ML models"""
        features = {}
        
        features['patient_id'] = patient_data.get('id', '')
        features['age'] = patient_data.get('age', 0)
        features['gender'] = 1 if patient_data.get('gender') == 'Male' else 0
        features['blood_group'] = patient_data.get('blood_group', 'Unknown')
        
        features['heart_rate'] = vitals.get('heart_rate', 0)
        features['respiratory_rate'] = vitals.get('respiratory_rate', 0)
        features['temperature'] = vitals.get('temperature', 0)
        features['systolic_bp'] = vitals.get('systolic_bp', 0)
        features['diastolic_bp'] = vitals.get('diastolic_bp', 0)
        features['spo2'] = vitals.get('spo2', 0)
        
        news = ClinicalDecisionSupport.calculate_news(vitals)
        features['news_score'] = news['score']
        features['news_risk'] = news['risk_level']
        
        lab_results_list = []
        for lab in lab_results:
            if lab.get('status') == 'Completed':
                lab_results_list.append({
                    'test_name': lab.get('test_name', ''),
                    'result': lab.get('result', ''),
                    'date': lab.get('date_completed', '')
                })
        features['lab_tests'] = lab_results_list
        
        diagnoses = []
        for record in emr_records:
            if record.get('diagnosis'):
                diagnoses.append(record.get('diagnosis'))
        features['diagnoses'] = diagnoses
        
        medications = []
        for prescription in prescriptions:
            medications.append({
                'drug': prescription.get('drug_name', ''),
                'quantity': prescription.get('quantity', 0)
            })
        features['medications'] = medications
        
        features['num_hospital_visits'] = len(emr_records)
        features['num_lab_tests'] = len(lab_results)
        features['has_radiology'] = len(radiology_reports) > 0
        features['num_prescriptions'] = len(prescriptions)
        
        risk_score = 0
        if features['age'] > 60:
            risk_score += 2
        if features['news_score'] > 5:
            risk_score += 3
        elif features['news_score'] > 3:
            risk_score += 1
        if len(diagnoses) > 2:
            risk_score += 1
        if features['num_hospital_visits'] > 3:
            risk_score += 1
        features['risk_score'] = risk_score
        
        if risk_score >= 5:
            features['overall_risk'] = 'High'
        elif risk_score >= 3:
            features['overall_risk'] = 'Medium'
        else:
            features['overall_risk'] = 'Low'
        
        return features
    
    @staticmethod
    def extract_pathology_details(patient_data, lab_results, radiology_reports):
        """Extract detailed pathological information for ML training"""
        pathology = {
            'patient_id': patient_data.get('id', ''),
            'age': patient_data.get('age', 0),
            'gender': patient_data.get('gender', ''),
            'blood_group': patient_data.get('blood_group', ''),
            'lab_results': [],
            'radiology_findings': [],
            'biomarkers': {},
            'risk_factors': []
        }
        
        for lab in lab_results:
            if lab.get('status') == 'Completed':
                result = lab.get('result', '')
                test_name = lab.get('test_name', '')
                
                lab_entry = {
                    'test': test_name,
                    'result': result,
                    'unit': lab.get('unit', ''),
                    'reference_range': lab.get('reference', ''),
                    'is_abnormal': MLDataExtractor.is_abnormal(result, lab.get('reference', '')),
                    'date': lab.get('date_completed', '')
                }
                pathology['lab_results'].append(lab_entry)
                
                if 'glucose' in test_name.lower():
                    try:
                        val = float(re.findall(r'[\d.]+', str(result))[0])
                        pathology['biomarkers']['glucose'] = val
                        if val > 126:
                            pathology['risk_factors'].append('hyperglycemia')
                    except (ValueError, IndexError):
                        pass
                
                if 'hba1c' in test_name.lower():
                    try:
                        val = float(re.findall(r'[\d.]+', str(result))[0])
                        pathology['biomarkers']['hba1c'] = val
                        if val > 6.5:
                            pathology['risk_factors'].append('elevated_hba1c')
                    except (ValueError, IndexError):
                        pass
                
                if 'creatinine' in test_name.lower():
                    try:
                        val = float(re.findall(r'[\d.]+', str(result))[0])
                        pathology['biomarkers']['creatinine'] = val
                        if val > 1.2:
                            pathology['risk_factors'].append('elevated_creatinine')
                    except (ValueError, IndexError):
                        pass
                
                if 'hemoglobin' in test_name.lower() or 'hb' in test_name.lower():
                    try:
                        val = float(re.findall(r'[\d.]+', str(result))[0])
                        pathology['biomarkers']['hemoglobin'] = val
                        if val < 12:
                            pathology['risk_factors'].append('anemia')
                    except (ValueError, IndexError):
                        pass
                
                if 'wbc' in test_name.lower() or 'white blood' in test_name.lower():
                    try:
                        val = float(re.findall(r'[\d.]+', str(result))[0])
                        pathology['biomarkers']['wbc'] = val
                        if val > 11:
                            pathology['risk_factors'].append('leukocytosis')
                        elif val < 4:
                            pathology['risk_factors'].append('leukopenia')
                    except (ValueError, IndexError):
                        pass
        
        for report in radiology_reports:
            if report.get('status') == 'Completed':
                pathology['radiology_findings'].append({
                    'study': report.get('study', ''),
                    'findings': report.get('findings', ''),
                    'impression': report.get('impression', ''),
                    'date': report.get('date_completed', '')
                })
        
        risk_count = len(pathology['risk_factors'])
        if risk_count >= 3:
            pathology['overall_risk'] = 'High'
        elif risk_count >= 2:
            pathology['overall_risk'] = 'Medium'
        elif risk_count >= 1:
            pathology['overall_risk'] = 'Low'
        else:
            pathology['overall_risk'] = 'Normal'
        
        return pathology
    
    @staticmethod
    def is_abnormal(result, reference_range):
        if not result or not reference_range:
            return False
        
        try:
            num_result = float(re.findall(r'[\d.]+', str(result))[0])
            
            if '-' in reference_range:
                parts = reference_range.replace(' ', '').split('-')
                low = float(parts[0])
                high = float(parts[1])
                return num_result < low or num_result > high
            elif '<' in reference_range:
                high = float(re.findall(r'[\d.]+', reference_range)[0])
                return num_result > high
            elif '>' in reference_range:
                low = float(re.findall(r'[\d.]+', reference_range)[0])
                return num_result < low
        except (ValueError, IndexError):
            pass
        return False
    
    @staticmethod
    def save_ml_data(data, filename="ml_training_data.json"):
        try:
            existing_data = []
            if os.path.exists(filename):
                with open(filename, "r", encoding="utf-8") as f:
                    existing_data = json.load(f)
            
            existing_data.append(data)
            
            with open(filename, "w", encoding="utf-8") as f:
                json.dump(existing_data, f, indent=2, ensure_ascii=False)
            
            return True
        except Exception as e:
            print(f"Error saving ML data: {e}")
            return False

