    def register_patient(self):
        try:
            patient_data = {
                "patient_id": self.reg_patient_id.get(),
                "name": self.reg_patient_name.get(),
                "dob": self.reg_dob.get(),
                "gender": self.reg_gender.get(),
                "phone": self.reg_phone.get(),
                "address": self.reg_address.get(),
                "blood_group": self.reg_blood_group.get(),
                "registration_date": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            }
            
            if not patient_data["patient_id"] or not patient_data["name"]:
                messagebox.showwarning("Warning", "Patient ID and Name are required!")
                return
            
            age = self.calculate_age(patient_data["dob"])
            
            self.patients.append(patient_data)
            
            self.patient_bills.append({
                'patient_info': {
                    'id': patient_data["patient_id"],
                    'name': patient_data["name"],
                    'age': age,
                    'gender': patient_data["gender"],
                    'phone': patient_data["phone"],
                    'blood_group': patient_data["blood_group"]
                },
                'items': [],
                'total': 0,
                'timestamp': patient_data["registration_date"],
                'bill_id': f"REG{patient_data['patient_id']}"
            })
            
            self.save_patient_data(patient_data)
            self.save_data_to_files()
            self.refresh_patient_tree()
            
            self.set_current_patient(patient_data["patient_id"])
            self.active_patient_label.config(text=f"{patient_data['name']} (ID: {patient_data['patient_id']})")
            
            self.clear_patient_form()
            messagebox.showinfo("Success", f"Patient {patient_data['name']} registered and selected!\n\n"
                               f"The patient is now active in all sections.")
            
        except Exception as e:
            messagebox.showerror("Error", f"Failed to register patient: {str(e)}")

    def calculate_age(self, dob_str):
        try:
            dob = datetime.strptime(dob_str, "%Y-%m-%d")
            today = datetime.now()
            age = today.year - dob.year - ((today.month, today.day) < (dob.month, dob.day))
            return str(age)
        except (ValueError, TypeError):
            return ""

    def save_patient_data(self, patient_data):
        try:
            patients = []
            if os.path.exists("patients.json"):
                with open("patients.json", "r", encoding="utf-8") as f:
                    patients = json.load(f)
            
            patients.append(patient_data)
            
            with open("patients.json", "w", encoding="utf-8") as f:
                json.dump(patients, f, indent=2)
        except Exception as e:
            print(f"Error saving patient data: {e}")

