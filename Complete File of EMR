class ClinicalDecisionSupport:
    """AI-powered clinical decision support system"""
    
    @staticmethod
    def calculate_news(vitals):
        """Calculate National Early Warning Score (NEWS)"""
        score = 0
        explanations = []
        
        # Respiratory Rate
        rr = vitals.get('respiratory_rate', 0)
        if rr:
            try:
                rr = float(rr)
                if rr <= 8:
                    score += 3
                    explanations.append("RR <= 8 (3 pts)")
                elif rr <= 11:
                    score += 1
                    explanations.append("RR 9-11 (1 pt)")
                elif rr <= 20:
                    score += 0
                    explanations.append("RR 12-20 (0 pts)")
                elif rr <= 24:
                    score += 2
                    explanations.append("RR 21-24 (2 pts)")
                elif rr <= 30:
                    score += 3
                    explanations.append("RR 25-30 (3 pts)")
                else:
                    score += 3
                    explanations.append("RR > 30 (3 pts)")
            except ValueError:
                pass
        
        # SpO2
        spo2 = vitals.get('spo2', 0)
        if spo2:
            try:
                spo2 = float(spo2)
                if spo2 <= 91:
                    score += 3
                    explanations.append("SpO2 <= 91% (3 pts)")
                elif spo2 <= 93:
                    score += 2
                    explanations.append("SpO2 92-93% (2 pts)")
                elif spo2 <= 95:
                    score += 1
                    explanations.append("SpO2 94-95% (1 pt)")
                else:
                    score += 0
                    explanations.append("SpO2 >= 96% (0 pts)")
            except ValueError:
                pass
        
        # Temperature
        temp = vitals.get('temperature', 0)
        if temp:
            try:
                temp = float(temp)
                if temp <= 35.0:
                    score += 3
                    explanations.append("Temp <= 35.0°C (3 pts)")
                elif temp <= 36.0:
                    score += 1
                    explanations.append("Temp 35.1-36.0°C (1 pt)")
                elif temp <= 38.0:
                    score += 0
                    explanations.append("Temp 36.1-38.0°C (0 pts)")
                elif temp <= 39.0:
                    score += 1
                    explanations.append("Temp 38.1-39.0°C (1 pt)")
                else:
                    score += 2
                    explanations.append("Temp > 39.0°C (2 pts)")
            except ValueError:
                pass
        
        # Systolic BP
        sbp = vitals.get('systolic_bp', 0)
        if sbp:
            try:
                sbp = float(sbp)
                if sbp <= 90:
                    score += 3
                    explanations.append("SBP <= 90 (3 pts)")
                elif sbp <= 100:
                    score += 2
                    explanations.append("SBP 91-100 (2 pts)")
                elif sbp <= 110:
                    score += 1
                    explanations.append("SBP 101-110 (1 pt)")
                else:
                    score += 0
                    explanations.append("SBP >= 111 (0 pts)")
            except ValueError:
                pass
        
        # Heart Rate
        hr = vitals.get('heart_rate', 0)
        if hr:
            try:
                hr = float(hr)
                if hr <= 40:
                    score += 3
                    explanations.append("HR <= 40 (3 pts)")
                elif hr <= 50:
                    score += 1
                    explanations.append("HR 41-50 (1 pt)")
                elif hr <= 90:
                    score += 0
                    explanations.append("HR 51-90 (0 pts)")
                elif hr <= 110:
                    score += 1
                    explanations.append("HR 91-110 (1 pt)")
                elif hr <= 130:
                    score += 2
                    explanations.append("HR 111-130 (2 pts)")
                else:
                    score += 3
                    explanations.append("HR > 130 (3 pts)")
            except ValueError:
                pass
        
        # Consciousness (AVPU)
        consciousness = vitals.get('consciousness', 'alert')
        if consciousness and consciousness.lower() != 'alert':
            score += 3
            explanations.append(f"Consciousness: {consciousness} (3 pts)")
        
        return {
            'score': score,
            'explanations': explanations,
            'risk_level': ClinicalDecisionSupport.get_news_risk(score)
        }
    
    @staticmethod
    def get_news_risk(score):
        if score >= 7:
            return "High Risk - Urgent clinical review required"
        elif score >= 5:
            return "Medium Risk - Clinical review within 30 minutes"
        elif score >= 3:
            return "Low Risk - Clinical review within 1 hour"
        else:
            return "Normal - Routine monitoring"
    
