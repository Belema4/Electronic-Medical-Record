    def show_patient_selector(self):
        dialog = tk.Toplevel(self.root)
        dialog.title("Select Patient")
        dialog.geometry("600x400")
        dialog.transient(self.root)
        dialog.grab_set()
        
        ttk.Label(dialog, text="Search Patient:", font=('Arial', 12, 'bold')).pack(pady=10)
        
        search_frame = ttk.Frame(dialog)
        search_frame.pack(fill='x', padx=20, pady=5)
        
        ttk.Label(search_frame, text="Search:").pack(side='left', padx=5)
        search_entry = ttk.Entry(search_frame, width=30)
        search_entry.pack(side='left', padx=5)
        
        tree_frame = ttk.Frame(dialog)
        tree_frame.pack(fill='both', expand=True, padx=20, pady=10)
        
        columns = ("ID", "Name", "Age", "Gender", "Phone", "Blood Group")
        tree = ttk.Treeview(tree_frame, columns=columns, show='headings', height=10)
        for col in columns:
            tree.heading(col, text=col)
            tree.column(col, width=100)
        
        scrollbar = ttk.Scrollbar(tree_frame, orient='vertical', command=tree.yview)
        tree.configure(yscrollcommand=scrollbar.set)
        scrollbar.pack(side='right', fill='y')
        tree.pack(side='left', fill='both', expand=True)
        
        def load_patients(search_term=""):
            for item in tree.get_children():
                tree.delete(item)
            
            search_term = search_term.lower()
            for bill in self.patient_bills:
                if 'patient_info' in bill:
                    p = bill['patient_info']
                    name = p.get('name', '').lower()
                    pid = p.get('id', '').lower()
                    if search_term in name or search_term in pid:
                        tree.insert("", "end", values=(
                            p.get('id', ''), p.get('name', ''), p.get('age', ''),
                            p.get('gender', ''), p.get('phone', ''), p.get('blood_group', '')
                        ), tags=(p.get('id', ''),))
        
        def on_search(event=None):
            load_patients(search_entry.get())
        
        search_entry.bind('<KeyRelease>', on_search)
        load_patients()
        
        def select_patient():
            selected = tree.selection()
            if selected:
                values = tree.item(selected[0])['values']
                patient_id = values[0]
                self.set_current_patient(patient_id)
                self.active_patient_label.config(text=f"{values[1]} (ID: {patient_id})")
                dialog.destroy()
                messagebox.showinfo("Patient Selected", f"Patient {values[1]} is now active across all sections")
        
        btn_frame = ttk.Frame(dialog)
        btn_frame.pack(pady=10)
        ttk.Button(btn_frame, text="Select Patient", command=select_patient).pack(side='left', padx=10)
        ttk.Button(btn_frame, text="Close", command=dialog.destroy).pack(side='left', padx=10)

