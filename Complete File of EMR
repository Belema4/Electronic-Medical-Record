            filetypes=[
                ("Image files", "*.jpg *.jpeg *.png *.bmp *.gif *.tiff *.webp"),
                ("PDF files", "*.pdf"),
                ("Word files", "*.doc *.docx"),
                ("Text files", "*.txt"),
                ("All files", "*.*")
            ]
        )
        
        if filename:
            self.process_uploaded_file(filename, "File")

    def process_uploaded_file(self, filename, file_type):
        try:
            patient_id = self.results_patient_id.get() if self.results_patient_id else ""
            result_type = self.result_type_combo.get() if self.result_type_combo else "Document"
            description = self.result_desc_entry.get() if self.result_desc_entry else ""
            
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            result_id = f"RESULT_{patient_id}_{timestamp}"
            
            results_dir = "patient_results"
            if not os.path.exists(results_dir):
                os.makedirs(results_dir)
            
            file_ext = os.path.splitext(filename)[1]
            new_filename = f"{result_id}{file_ext}"
            new_path = os.path.join(results_dir, new_filename)
            
            shutil.copy2(filename, new_path)
            
            metadata = {
                "result_id": result_id,
                "patient_id": patient_id,
                "result_type": result_type,
                "description": description,
                "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "file_path": new_path,
                "file_type": file_type,
                "original_filename": os.path.basename(filename)
            }
            
            results_file = os.path.join(results_dir, "results_metadata.json")
            try:
                if os.path.exists(results_file):
                    with open(results_file, "r", encoding="utf-8") as f:
                        results_data = json.load(f)
                else:
                    results_data = []
                
                results_data.append(metadata)
                
                with open(results_file, "w", encoding="utf-8") as f:
                    json.dump(results_data, f, indent=2, ensure_ascii=False)
                
            except Exception as e:
                messagebox.showerror("Error", f"Failed to save metadata: {str(e)}")
            
            self.refresh_results_list()
            messagebox.showinfo("Success", f"Result saved!\nFile: {new_filename}\nID: {result_id}")
            
        except Exception as e:
            messagebox.showerror("Error", f"Failed to process file: {str(e)}")

    def view_result(self, event=None):
        selected = self.results_tree.selection()
        if not selected:
            messagebox.showwarning("Warning", "Please select a result to view")
            return
        
        values = self.results_tree.item(selected[0])['values']
        result_id = values[3] if len(values) > 3 else ""
        
        results_file = "patient_results/results_metadata.json"
        if os.path.exists(results_file):
            try:
                with open(results_file, "r", encoding="utf-8") as f:
                    all_results = json.load(f)
                
                result = None
                for r in all_results:
                    if r.get('result_id') == result_id:
                        result = r
                        break
                
                if result:
                    view_win = tk.Toplevel(self.root)
                    view_win.title(f"Result: {result_id}")
                    view_win.geometry("700x600")
                    
                    info_frame = ttk.LabelFrame(view_win, text="Result Information", padding=10)
                    info_frame.pack(fill='x', padx=10, pady=5)
                    
                    ttk.Label(info_frame, text=f"Result ID: {result_id}").pack(anchor='w')
                    ttk.Label(info_frame, text=f"Patient: {result.get('patient_id', '')}").pack(anchor='w')
                    ttk.Label(info_frame, text=f"Type: {result.get('result_type', '')}").pack(anchor='w')
                    ttk.Label(info_frame, text=f"Date: {result.get('timestamp', '')}").pack(anchor='w')
                    ttk.Label(info_frame, text=f"Description: {result.get('description', '')}").pack(anchor='w')
                    
                    file_path = result.get('file_path', '') or result.get('image_path', '')
                    if file_path and os.path.exists(file_path) and PIL_AVAILABLE:
                        file_ext = os.path.splitext(file_path)[1].lower()
                        if file_ext in ['.jpg', '.jpeg', '.png', '.bmp', '.gif', '.tiff', '.webp']:
                            try:
                                image = Image.open(file_path)
                                max_size = (600, 450)
                                image.thumbnail(max_size, Image.LANCZOS)
                                
                                photo = ImageTk.PhotoImage(image)
                                img_label = ttk.Label(view_win, image=photo)
                                img_label.image = photo
                                img_label.pack(padx=10, pady=10)
                            except Exception as e:
                                ttk.Label(view_win, text=f"Could not display image: {e}").pack(pady=10)
                        else:
                            ttk.Label(view_win, text=f"File: {os.path.basename(file_path)}", font=('Arial', 10, 'bold')).pack(pady=20)
                            ttk.Label(view_win, text="This file type cannot be previewed").pack()
                    else:
                        ttk.Label(view_win, text="File not found").pack(pady=20)
                    
                    ttk.Button(view_win, text="Close", command=view_win.destroy).pack(pady=10)
                    
            except Exception as e:
                messagebox.showerror("Error", f"Failed to load result: {str(e)}")

