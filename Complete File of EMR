    def load_data_from_files(self):
        file_mappings = {
            "procedures.json": "procedures",
            "investigations.json": "investigations",
            "drugs.json": "drugs",
            "other_charges.json": "other_charges",
            "bills.json": "patient_bills",
            "inventory_log.json": "drug_inventory_log",
            "emr.json": "emr_records",
            "appointments.json": "appointments",
            "lab_tests.json": "lab_tests",
            "prescriptions.json": "prescriptions",
            "consent_forms.json": "consent_forms",
            "patients.json": "patients",
        }
        for filename, attr_name in file_mappings.items():
            try:
                if os.path.exists(filename):
                    with open(filename, "r", encoding="utf-8") as f:
                        data = json.load(f)
                        if isinstance(data, list):
                            setattr(self, attr_name, data)
            except (json.JSONDecodeError, IOError, PermissionError) as e:
                print(f"Warning: Could not load {filename}: {e}")
        
        try:
            if os.path.exists("radiology_requests.json"):
                with open("radiology_requests.json", "r", encoding="utf-8") as f:
                    self.radiology_requests = json.load(f)
            else:
                self.radiology_requests = []
        except Exception as e:
            print(f"Warning: Could not load radiology_requests.json: {e}")
            self.radiology_requests = []

    def save_data_to_files(self):
        file_mappings = {
            "procedures.json": self.procedures,
            "investigations.json": self.investigations,
            "drugs.json": self.drugs,
            "other_charges.json": self.other_charges,
            "bills.json": self.patient_bills,
            "inventory_log.json": self.drug_inventory_log,
            "emr.json": self.emr_records,
            "appointments.json": self.appointments,
            "lab_tests.json": self.lab_tests,
            "prescriptions.json": getattr(self, 'prescriptions', []),
            "consent_forms.json": getattr(self, 'consent_forms', []),
            "patients.json": getattr(self, 'patients', []),
        }
        for filename, data in file_mappings.items():
            try:
                with open(filename, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=2, ensure_ascii=False)
            except (IOError, PermissionError) as e:
                print(f"Warning: Could not save {filename}: {e}")
        
        try:
            with open("radiology_requests.json", "w", encoding="utf-8") as f:
                json.dump(getattr(self, 'radiology_requests', []), f, indent=2, ensure_ascii=False)
        except Exception as e:
            print(f"Warning: Could not save radiology_requests.json: {e}")

