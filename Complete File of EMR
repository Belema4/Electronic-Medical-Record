            total_patients = len(set(bill['patient_info']['id'] for bill in self.patient_bills if 'patient_info' in bill))
            today = datetime.now().strftime("%Y-%m-%d")
            todays_appointments = len([apt for apt in self.appointments if apt.get('date') == today])
            
            week_ago = (datetime.now() - timedelta(days=7)).strftime("%Y-%m-%d")
            recent_bills = [bill for bill in self.patient_bills 
                           if 'timestamp' in bill and bill['timestamp'].split()[0] >= week_ago]
            active_billing = sum(bill.get('total', 0) for bill in recent_bills)
            
            low_stock = len([drug for drug in self.drugs 
                            if drug.get('quantity', 0) <= drug.get('min_stock', 0)])
            
            news_alerts = 0
            for emr in self.emr_records[-20:]:
                vitals = {
                    'respiratory_rate': emr.get('respiratory_rate', 0),
                    'spo2': emr.get('spo2', 0),
                    'temperature': emr.get('temperature', 0),
                    'systolic_bp': emr.get('systolic_bp', 0),
                    'heart_rate': emr.get('heart_rate', 0),
                    'consciousness': 'alert'
                }
                news = ClinicalDecisionSupport.calculate_news(vitals)
                if news['score'] >= 5:
                    news_alerts += 1
            
            self.stats_vars["Total Patients"].set(str(total_patients))
            self.stats_vars["Today's Appointments"].set(str(todays_appointments))
            self.stats_vars["Active Billing"].set(f"₦{active_billing:,.2f}")
            self.stats_vars["Drug Stock Alert"].set(str(low_stock))
            self.stats_vars["NEWS Alerts"].set(str(news_alerts))
            
            self.activity_text.delete(1.0, tk.END)
            if self.patient_bills:
                self.activity_text.insert(tk.END, "Recent Bills:\n")
                for bill in reversed(self.patient_bills[-5:]):
                    if 'patient_info' in bill and 'timestamp' in bill:
                        self.activity_text.insert(tk.END, 
                            f"  {bill['timestamp'].split()[0]}: {bill['patient_info'].get('name', 'Unknown')} - ₦{bill.get('total', 0):,.2f}\n")
            
            if news_alerts > 0:
                self.activity_text.insert(tk.END, f"\n⚠️ {news_alerts} patient(s) have high NEWS scores requiring attention!\n")
            
            if self.current_patient_data:
                self.active_patient_label.config(text=f"{self.current_patient_data.get('name', 'Unknown')} (ID: {self.current_patient_data.get('id', '')})")
            
        except Exception as e:
            print(f"Error updating dashboard: {e}")
        
        self.root.after(60000, self.update_dashboard)

