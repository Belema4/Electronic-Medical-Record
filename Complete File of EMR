    def refresh_patient_tree(self):
        for item in self.patient_tree.get_children():
            self.patient_tree.delete(item)
        
        for bill in self.patient_bills:
            if 'patient_info' in bill:
                p = bill['patient_info']
                self.patient_tree.insert("", "end", values=(
                    p.get('id', ''), p.get('name', ''), p.get('age', ''),
                    p.get('gender', ''), p.get('phone', ''), p.get('blood_group', ''),
                    bill.get('timestamp', '')
                ))

